# ============================================================
#  이 파일에 키를 채운 뒤 반드시 Ctrl+S 로 저장하세요.
#  등호(=) 뒤에 바로 붙여넣고, 따옴표나 띄어쓰기는 넣지 마세요.
# ============================================================

# ===== 1단계에 꼭 필요한 것 (2개) =====

# (1) 글을 써주는 AI. 기본값은 gemini (무료, 카드 등록 불필요)
#     https://aistudio.google.com/apikey 에서 발급. AQ. 로 시작합니다 (구형은 AIza).
GEMINI_API_KEY=

#     Claude 를 쓰기로 했다면 위는 비우고 아래를 채우세요 (유료, sk-ant- 로 시작)
ANTHROPIC_API_KEY=

# (2) 승인 버튼을 보내주는 텔레그램 봇
#     텔레그램 @BotFather 에게 /newbot 하면 줍니다. 숫자:영문 형태입니다.
TELEGRAM_BOT_TOKEN=

#     아래는 비워두세요. setup_check.py 가 자동으로 찾아줍니다.
TELEGRAM_CHAT_ID=

# ===== X 자동 발행용 (선택. 없으면 텔레그램 버튼으로 반자동 발행) =====
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ===== 스레드 자동 발행용 (선택) =====
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ===== 2단계(수익 연결)에서 사용 =====
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# (선택) 블로그 봇에서 상호명으로 장소 정보를 채울 때 씁니다.
# https://developers.kakao.com > 내 애플리케이션 > REST API 키
KAKAO_REST_API_KEY=

# 블로그 글쓰기 봇 전용 토큰. 메인 봇과 반드시 달라야 합니다.
# 텔레그램에서 @BotFather -> /newbot -> 이름 정하면 토큰을 줍니다.
BLOG_BOT_TOKEN=

# (선택) 구글 상위 글 벤치마킹. 무료 하루 100건.
# 키: console.cloud.google.com > Custom Search API 사용 설정 > API 키
# ID: programmablesearchengine.google.com 에서 검색엔진 만들고 '검색엔진 ID'
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
